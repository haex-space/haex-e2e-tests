# haex-e2e-tests Environment Configuration
# Copy to .env and adjust as needed

# =============================================================================
# SERVICE VERSIONS
# =============================================================================
# Each service can be pinned to a specific version.
# Valid values: release | nightly | main | <branch-name> | <tag> | <commit-sha>
#
# Examples:
#   HAEX_VAULT_VERSION=main          # Latest main branch
#   HAEX_VAULT_VERSION=v1.2.0        # Specific release tag
#   HAEX_VAULT_VERSION=feat/new-ui   # Feature branch
#   HAEX_VAULT_VERSION=abc1234       # Specific commit

HAEX_VAULT_VERSION=main
HAEXTENSION_VERSION=main
VAULT_SDK_VERSION=main
HAEX_SYNC_SERVER_VERSION=main

# =============================================================================
# LOCAL HAEX-VAULT SOURCE (Optional — for in-flight branch testing)
# =============================================================================
# Point the vault-a/vault-b builds at a local haex-vault checkout instead of
# cloning from GitHub. Useful to run the full E2E suite against a branch
# that hasn't been pushed yet, or to iterate without a push cycle.
#
# Activate with BOTH variables below:
#   HAEX_VAULT_LOCAL_PATH — absolute or compose-relative path to your checkout
#   USE_LOCAL_VAULT=true  — tells the Dockerfile to prefer the mount
#
# Leave USE_LOCAL_VAULT=false (or unset) to fall back to git clone @ HAEX_VAULT_VERSION.
#
# HAEX_VAULT_LOCAL_PATH=/home/you/Projekte/haex-vault
# USE_LOCAL_VAULT=false

# =============================================================================
# VERSION PRESET (Optional)
# =============================================================================
# Use a preset to set all versions at once. Individual versions above will
# be ignored when a preset is active.
#
# Available presets:
#   release  - Use latest release tags for all services
#   nightly  - Use nightly builds (if available) or main
#   main     - Use main branch for all services (default)
#
# VERSION_PRESET=main

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# These are used by docker-compose.yml

# Timezone for containers
TZ=Europe/Berlin

# User/Group IDs (for file permissions)
PUID=1000
PGID=1000

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# =============================================================================
# SYNC SERVER
# =============================================================================
