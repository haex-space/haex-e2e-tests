# Base image for E2E test environment
#
# Contains all heavy system dependencies that rarely change:
# webtop desktop, system libs, Node.js, Rust, tauri-driver, Playwright
#
# Rebuild trigger: only when tooling versions change (Node, Rust, Playwright)
# Published to: ghcr.io/haex-space/haex-e2e-base:latest

# Pin to Ubuntu 24.04 (Noble) — ubuntu-xfce:latest moved to 26.04 which Playwright doesn't support yet
FROM lscr.io/linuxserver/webtop:ubuntu-xfce-version-c6f3d68b

ARG NODE_VERSION=22

# Use German mirror — archive.ubuntu.com is unreliable from CI runners and many networks
RUN sed -i 's|http://archive.ubuntu.com|http://de.archive.ubuntu.com|g' /etc/apt/sources.list.d/*.sources 2>/dev/null; \
    sed -i 's|http://archive.ubuntu.com|http://de.archive.ubuntu.com|g' /etc/apt/sources.list 2>/dev/null; \
    true

# Install system dependencies for Tauri
RUN apt-get update && apt-get install -y \
    # Tauri/WebKit dependencies
    libwebkit2gtk-4.1-dev \
    build-essential \
    curl \
    wget \
    file \
    libssl-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libsoup-3.0-dev \
    # Additional deps
    git \
    jq \
    unzip \
    # Playwright browser deps
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2t64 \
    # socat for cross-container communication (dual-vault tests)
    socat \
    # ffmpeg for desktop screen recording during tests
    ffmpeg \
    # WebKitWebDriver (required for tauri-driver)
    webkit2gtk-driver \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js via NodeSource
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Enable pnpm via corepack
RUN corepack enable pnpm

# Install Rust (force install to /root/.cargo since webtop uses /config as HOME)
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install tauri-cli and tauri-driver for E2E testing
RUN /root/.cargo/bin/cargo install tauri-cli tauri-driver

# Set Playwright browser path
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers

# Configure apt retries for future installs
RUN apt-get clean && rm -rf /var/lib/apt/lists/* && \
    echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries

# Create standard directories
RUN mkdir -p /app /app/test-results /repos /prebuilt
