{
  "name": "haex-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for haex-vault (core, external bridge, extension framework) and the haex-pass-browser extension",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "DISPLAY=:1 playwright test",
    "test:db": "bun test tests-db/",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:dual-vault": "DISPLAY=:1 playwright test tests/sync/dual-vault-sync.spec.ts",
    "start:vault": "./scripts/start-vault.sh",
    "start:all": "./scripts/start-all.sh",
    "docker:build": "docker compose --env-file .env -f docker/docker-compose.yml build",
    "docker:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "docker:up:vault-a": "docker compose --env-file .env -f docker/docker-compose.yml up -d vault-a",
    "docker:up:vault-b": "docker compose --env-file .env -f docker/docker-compose.yml up -d vault-b",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "docker:down:clean": "docker compose --env-file .env -f docker/docker-compose.yml down -v",
    "docker:test": "docker compose --env-file .env -f docker/docker-compose.yml exec vault-a pnpm test",
    "docker:test:dual-vault": "docker compose --env-file .env -f docker/docker-compose.yml exec vault-a pnpm test:dual-vault",
    "docker:shell": "docker compose --env-file .env -f docker/docker-compose.yml exec vault-a bash",
    "docker:shell:b": "docker compose --env-file .env -f docker/docker-compose.yml exec vault-b bash",
    "docker:logs": "docker compose --env-file .env -f docker/docker-compose.yml logs -f",
    "docker:logs:vault-a": "docker compose --env-file .env -f docker/docker-compose.yml logs -f vault-a",
    "docker:logs:vault-b": "docker compose --env-file .env -f docker/docker-compose.yml logs -f vault-b"
  },
  "devDependencies": {
    "@haex-space/ucan": "0.2.0",
    "@haex-space/vault-sdk": "^2.8.0",
    "@playwright/test": "^1.49.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.13",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "postgres": "^3.4.8",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  }
}
